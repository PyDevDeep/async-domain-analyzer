# ==============================================================================
# Domain Triaging System - Configuration Template
# ==============================================================================

# --- API KEYS ---
# Required for Pass 2 (Fallback) scraping via Serper.dev.
# Get your API key at: https://serper.dev
SERPER_API_KEY=your_api_key_here

# --- NETWORK & TIMEOUTS ---
# Total timeout for a single HTTP request (seconds)
HTTP_TIMEOUT_TOTAL=10
# Timeout for establishing a connection (seconds)
HTTP_TIMEOUT_CONNECT=3
# Timeout for reading data from a socket (seconds)
HTTP_TIMEOUT_SOCK_READ=5

# --- PERFORMANCE ---
# Default number of concurrent workers (can be overridden via --workers CLI flag)
DEFAULT_WORKERS=5

# --- STORAGE & CACHE ---
# Path to the SQLite cache database
CACHE_DB_PATH=data/cache.db
# How long to keep cached results (days)
CACHE_TTL_DAYS=7

# --- OUTPUT ---
# Directory where CSV and Markdown reports will be saved
OUTPUT_DIR=data
# Export sorting configuration: "false" to keep original order, "true" to sort by score (desc) and domain (asc)
EXPORT_SORT_BY_RELEVANCE=false
